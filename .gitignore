# Redacted fixtures are the ONLY tabular data allowed in the repo. They live in
# tests/fixtures/ and must contain no real account ids, balances, or stakes.
!tests/fixtures/**/*.csv
!tests/fixtures/**/*.xlsx
!tests/fixtures/**/*.pdf

